# --- Issabel / Asterisk ---
PBX_IP=192.168.200.14
# Leave PBX_PORT unset to get the default for the transport (5060 udp, 5061 tls).
# PBX_PORT=5060
SIP_EXTENSION=1001
SIP_SECRET=YourSecretHere
# Optional: auth username if it differs from the extension, and caller display name
# SIP_AUTH_USER=
# SIP_DISPLAY_NAME=

# Alternative to PBX_IP/PBX_PORT/PBX_TRANSPORT, as a SIP URI:
#   sips:192.168.200.14                   -> TLS on 5061
#   sip:192.168.200.14:5061;transport=tls -> TLS on 5061
#   sip:192.168.200.14                    -> UDP on 5060
# PBX_URI=

# --- Encryption towards the PBX ---
# Plain local mode (LAN desk phone):  PBX_TRANSPORT=udp, PBX_ENCRYPTION=false  (default)
# Encrypted remote mode (like Bria):  PBX_TRANSPORT=tls, PBX_ENCRYPTION=true
PBX_TRANSPORT=udp
# SRTP (RTP/SAVP + SDES a=crypto, AES_CM_128_HMAC_SHA1_80) for the audio.
# Defaults to true with tls and false with udp. Calls fail rather than fall back to plain RTP.
# PBX_ENCRYPTION=false

# TLS certificate checks (only used with PBX_TRANSPORT=tls)
# Trust this CA / self-signed PBX certificate (PEM). Recommended for a self-signed Issabel cert.
# PBX_TLS_CA=./certs/issabel.crt
# Name to check the certificate against when it doesn't contain PBX_IP as an IP SAN.
# PBX_TLS_SERVERNAME=issabel.example.local
# Skip verification entirely. Testing only: a man-in-the-middle could read the SRTP keys.
# PBX_TLS_VERIFY=true
# Client certificate, only if Asterisk requires one (tlsverifyclient=yes / verify_client=yes)
# PBX_TLS_CERT=
# PBX_TLS_KEY=

# --- Gateway ---
GATEWAY_PORT=4000
# Interface the HTTP/WebSocket server listens on. 127.0.0.1 = this PC only.
# Anyone who can reach this port can place calls on the extension above.
GATEWAY_HOST=127.0.0.1

# Local UDP port for SIP signalling towards the PBX (UDP mode; TLS uses an ephemeral port)
SIP_LOCAL_PORT=5062
# IP put in Contact / Via / SDP. Auto-detected (the interface that routes to PBX_IP) when empty.
# SIP_LOCAL_IP=

# G.711 codecs, in preference order. The first one is also used on the browser leg.
SIP_CODECS=PCMA,PCMU
# UDP port range for RTP/SRTP towards Asterisk (Asterisk's rtp.conf default is 10000-20000)
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000

# --- Call supervision: listen / whisper / takeover (optional) ---
# Needs an AMI user on Issabel with read=call, write=originate,call,reporting (see README). Leave AMI_USER empty to
# turn the feature off. A wrong secret is tried once only (fail2ban).
 AMI_HOST=192.168.200.14       # defaults to PBX_IP
 AMI_PORT=5038
 AMI_USER=arzen
AMI_SECRET=YourAmiSecretHere
# Channel the PBX rings for spy calls. Default: the agent's technology + SIP_EXTENSION (e.g. SIP/109).
# AMI_SPY_CHANNEL=SIP/109
# Channel peer names that count as agent extensions (everything else, e.g. trunks, is the "other party").
# AMI_AGENT_PATTERN=^\d{2,6}$

# Print every SIP message to the console (includes SRTP keys in the SDP in encrypted mode)
LOG_SIP=0
